// 1 m checker, so the character's movement reads clearly.
void fragment() {
	vec3 w = (INV_VIEW_MATRIX * vec4(VERTEX, 1.0)).xyz;
	float c = mod(floor(w.x) + floor(w.z), 2.0);
	ALBEDO = mix(vec3(0.42, 0.43, 0.45), vec3(0.52, 0.53, 0.55), c);
	ROUGHNESS = 0.9;
}
