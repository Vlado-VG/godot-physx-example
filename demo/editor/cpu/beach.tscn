[sub_resource type="Shader" id="Shader_caustics_receiver"]
code = "
shader_type spatial;
render_mode cull_back, diffuse_burley, specular_schlick_ggx;

// Opaque receiver material with an additive caustics overlay. The world-
// position projection works for flat, curved, and vertical receiver geometry;
// each receiving material gets the shared light-space map from lake.gd.
//
// Real bug, found by the user: this material is fully opaque (ALPHA is
// never set, so it's always 1.0) but had render_mode blend_mix,
// depth_draw_opaque copy-pasted in from the water shader -- blend_mix
// unconditionally puts a material in the transparent-pass pipeline
// regardless of its actual alpha, so the floor was rendering through the
// same pipeline as the translucent water for no reason, independent of
// whether water was even present above it. Removed -- this is a plain
// opaque surface and belongs in the normal opaque pass, like the walls.
uniform vec4 albedo_color : source_color = vec4(0.68, 0.6, 0.42, 1.0);
uniform float roughness_val : hint_range(0.0, 1.0) = 0.95;
uniform sampler2D caustics_tex : hint_default_black, filter_linear;
uniform vec3 caustics_origin = vec3(0.0);
uniform vec3 caustics_light_right = vec3(1.0, 0.0, 0.0);
uniform vec3 caustics_light_up = vec3(0.0, 0.0, 1.0);
uniform vec3 caustics_sun_direction = vec3(-0.35, -1.0, -0.25);
uniform float caustics_half_extent = 10.0;
uniform float caustics_filter_radius = 1.5;
uniform float caustics_surface_fade_depth = 1.25;
// The caustics repeat with the ocean tile (PhysXWaterSurface3D.get_caustics_tile_size()):
// folding the position into the tile around caustics_origin lights the whole
// seabed, not just the simulated square. 0 = no folding.
uniform vec2 caustics_tile_size = vec2(0.0);
// Caustics spread out and wash away with depth: gone below this (m), fading
// in from about a third of it.
uniform float caustics_max_depth = 4.0;
uniform float caustic_strength = 1.5;
uniform vec4 absorption_color : source_color = vec4(0.012, 0.07, 0.12, 1.0);
uniform float absorption_density : hint_range(0.0, 2.0) = 0.55;

varying vec3 v_world_position;
varying vec3 v_world_normal;
// Caustic light for this pixel, handed to light(): caustics are focused
// sunlight, so they're applied there, where the sun's shadow is known.
varying vec3 v_caustic;

void vertex() {
	v_world_position = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	v_world_normal = normalize(MODEL_NORMAL_MATRIX * NORMAL);
}

float sample_caustics(vec2 uv) {
	vec2 texel = 1.0 / vec2(textureSize(caustics_tex, 0));
	vec2 offset = texel * caustics_filter_radius;
	float center = texture(caustics_tex, uv).r * 4.0;
	float axial = (
		texture(caustics_tex, uv + vec2(offset.x, 0.0)).r +
		texture(caustics_tex, uv - vec2(offset.x, 0.0)).r +
		texture(caustics_tex, uv + vec2(0.0, offset.y)).r +
		texture(caustics_tex, uv - vec2(0.0, offset.y)).r
	) * 2.0;
	float diagonal = (
		texture(caustics_tex, uv + offset).r +
		texture(caustics_tex, uv - offset).r +
		texture(caustics_tex, uv + vec2(offset.x, -offset.y)).r +
		texture(caustics_tex, uv + vec2(-offset.x, offset.y)).r
	);
	return (center + axial + diagonal) / 16.0;
}

void fragment() {
	vec3 relative_position = v_world_position - caustics_origin;
	if (caustics_tile_size.x > 0.0 && caustics_tile_size.y > 0.0) {
		relative_position.xz -= caustics_tile_size * round(relative_position.xz / caustics_tile_size);
	}
	vec2 uv = vec2(
		dot(relative_position, caustics_light_right),
		dot(relative_position, caustics_light_up)
	) / (caustics_half_extent * 2.0) + 0.5;
	vec3 caustic = vec3(0.0);
	float depth_below_surface = caustics_origin.y - v_world_position.y;
	if (depth_below_surface > 0.0 &&
			uv.x >= 0.0 && uv.x <= 1.0 && uv.y >= 0.0 && uv.y <= 1.0) {
		float receiver_incidence = max(dot(normalize(v_world_normal), -normalize(caustics_sun_direction)), 0.0);
		float surface_fade = smoothstep(0.0, caustics_surface_fade_depth, depth_below_surface);
		surface_fade *= 1.0 - smoothstep(caustics_max_depth * 0.35, caustics_max_depth, depth_below_surface);
		// G = whether this spot's sunlight came through water at all (see
		// get_caustics_texture()): the outside of a wall lines up with lit
		// photons inside the pool, but its light never touched the water.
		float through_water = texture(caustics_tex, uv).g;
		caustic = vec3(sample_caustics(uv) * receiver_incidence * surface_fade * through_water);
	}
	float absorption = 1.0 - exp(-absorption_density * max(depth_below_surface, 0.0));
	ALBEDO = mix(albedo_color.rgb, absorption_color.rgb, absorption);
	v_caustic = caustic * caustic_strength * (1.0 - absorption * 0.85);
	ROUGHNESS = roughness_val;
	METALLIC = 0.0;
}

void light() {
	DIFFUSE_LIGHT += clamp(dot(NORMAL, LIGHT), 0.0, 1.0) * ATTENUATION * LIGHT_COLOR / PI;
	if (LIGHT_IS_DIRECTIONAL) {
		// Shadowed like the sunlight itself: no caustics in a wall's or a
		// floating body's shadow (as emission they ignored shadows).
		SPECULAR_LIGHT += v_caustic * ATTENUATION * LIGHT_COLOR / PI;
	}
}
"

